#!/usr/bin/env bash
#
# 커밋 제목 검사. 팀이 .claude/stack.md §3 에 적은 규칙만 보고 비운 칸은 검사하지 않는다.
# 템플릿이 규칙을 정해 두지 않는 까닭은 팀마다 정한 게 없을 수 있어서다.
# 선언과 뜻은 .claude/stack.md §3 (COMMIT_TYPES · COMMIT_ISSUE_KEY).
#
# mr-check.sh 도 이 파일을 그대로 부른다. 규칙을 두 곳에 적으면 커밋 때와 MR 때 결과가 갈라진다.
#
# 설치: bash .claude/hooks/install.sh — pre-commit 과 같은 폴더라 같이 걸린다.
# 우회: git commit --no-verify — 급할 때만 쓰고 쓴 사실을 PR 에 적는다.

set -uo pipefail
# 패턴이 전부 ASCII 라 바이트로 본다. UTF-8 로캘에서는 깨진 바이트가 든 제목을 grep 이 못 맞춰 엉뚱하게 막는다.
export LC_ALL=C

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
STACK="$ROOT/.claude/stack.md"
[ -f "$STACK" ] || exit 0

# 선언을 잘못 적었으면 제목 탓을 하지 않고 설정 탓이라고 멈춘다.
# 조용히 넘기면 규칙이 꺼진 줄 모르고, 제목 탓을 하면 모든 커밋이 왜 막히는지 모른다.
bad_config() {
  printf '\n!! .claude/stack.md §3 의 선언이 형식에 안 맞는다: %s\n' "$1" >&2
  printf '   %s\n' "$2" >&2
  printf '   규칙을 안 쓰려면 "" 로 비운다.\n\n' >&2
  exit 1
}

# CR 을 먼저 뗀다. Windows 에서 받은 stack.md 를 Linux 쪽에서 읽으면
# 선언이 한 줄도 안 읽혀서 규칙이 조용히 꺼진다.
decl="$(awk '{ sub(/\r$/, "") } /^```sh$/{f=1;next} f&&/^```$/{exit} f' "$STACK" \
  | grep -E '^[[:space:]]*(export[[:space:]]+)?(COMMIT_TYPES|COMMIT_ISSUE_KEY)=')"
# 따옴표를 빼거나 들여 쓰면 대입이 안 돼서 규칙이 조용히 꺼진다. 그래서 줄 모양부터 본다.
odd="$(printf '%s\n' "$decl" \
  | grep -vE '^(COMMIT_TYPES|COMMIT_ISSUE_KEY)="[^"]*"[[:space:]]*(#.*)?$' | grep . | head -n 1)"
[ -z "$odd" ] || bad_config "$odd" '한 줄에 이름="값" 으로 적고 값은 큰따옴표로 감싼다'

COMMIT_TYPES=""
COMMIT_ISSUE_KEY=""
eval "$decl"
case "$COMMIT_TYPES"     in *"채워넣기"*) COMMIT_TYPES="" ;; esac
case "$COMMIT_ISSUE_KEY" in *"채워넣기"*) COMMIT_ISSUE_KEY="" ;; esac

[ -n "$COMMIT_TYPES$COMMIT_ISSUE_KEY" ] || exit 0   # 적은 규칙이 없다

if [ -n "$COMMIT_TYPES" ] \
   && ! printf '%s' "$COMMIT_TYPES" | grep -qE '^[A-Za-z][A-Za-z0-9-]*(\|[A-Za-z][A-Za-z0-9-]*)*$'; then
  bad_config "COMMIT_TYPES=\"$COMMIT_TYPES\"" '영문 타입을 | 로 구분해 적는다. 예: "feat|fix|docs"'
fi
if [ -n "$COMMIT_ISSUE_KEY" ] \
   && ! printf '%s' "$COMMIT_ISSUE_KEY" | grep -qE '^[A-Z][A-Z0-9_]*$'; then
  bad_config "COMMIT_ISSUE_KEY=\"$COMMIT_ISSUE_KEY\"" '번호 앞의 대문자 부분만 적는다. PROJ-12 라면 "PROJ"'
fi

MSG_FILE="${1:-}"
[ -f "$MSG_FILE" ] || exit 0   # mr-check 가 선언만 보려고 인자 없이 부를 때도 여기서 끝난다

# 제목은 git 이 저장할 첫 줄과 같아야 한다.
# git 은 편집기를 띄웠을 때만 주석 줄을 지운다. -m · -F 로 쓴 '#12 버그 고침' 은 그대로 제목이다.
# 편집기를 안 띄울 때 git 이 GIT_EDITOR=: 를 넘겨 주니 그걸로 가른다.
# 한계: commit.cleanup=strip 에서 -m 으로 준 # 줄은 git 이 지우지만 훅은 제목으로 본다.
cc='#'
if [ "${GIT_EDITOR:-}" = ":" ]; then
  cc=''
else
  # core.commentChar 와 core.commentString 가운데 나중에 적힌 쪽이 이긴다. git 과 같다.
  c="$(git config --get-regexp '^core\.comment(char|string)$' 2>/dev/null | tail -n 1 | cut -d' ' -f2-)"
  case "$c" in ''|auto) ;; *) cc="$c" ;; esac
fi
title="$(cc="$cc" awk '{ sub(/\r$/, "") }
  ENVIRON["cc"] != "" && index($0, ENVIRON["cc"]) == 1 { next }
  /[^ \t]/ { print; exit }' "$MSG_FILE")"
[ -n "$title" ] || exit 0   # 빈 메시지는 git 이 알아서 막는다

# git 이 만든 제목은 사람이 형식을 고를 수 없어서 건너뛴다.
# Merge 제목은 병합 중일 때만 git 이 만든다. 사람이 'Merge …' 로 쓴 제목은 검사한다.
case "$title" in
  'Revert "'*|'Reapply "'*) exit 0 ;;
  "fixup! "*|"squash! "*|"amend! "*)
    # 로컬에서는 나중에 합칠 커밋이라 건너뛴다. MR 은 마지막 관문이라 합치지 않은 채 들어가지 않게
    # mr-check.sh 가 MR_CHECK=1 을 넘길 때는 막는다.
    [ -n "${MR_CHECK:-}" ] || exit 0
    printf '\n!! 합치지 않은 고침 커밋이 남았다 — %s\n' "$title" >&2
    printf '   git rebase -i --autosquash <기준 브랜치> 로 합친 뒤 다시 올린다.\n\n' >&2
    exit 1 ;;
  "Merge "*) git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0 ;;
esac

fail() {
  printf '\n!! 제목이 .claude/stack.md §3 규칙에 안 맞는다 — %s\n' "$1" >&2
  printf '   제목: %s\n' "$title" >&2
  printf '   %s\n\n' "$2" >&2
  exit 1
}

if [ -n "$COMMIT_TYPES" ]; then
  # 타입과 모양을 따로 본다. 한 문구로 묶으면 타입이 틀렸는데 콜론만 들여다보게 된다.
  if ! printf '%s' "$title" | grep -qE "^(${COMMIT_TYPES})([(!:[:space:]]|$)"; then
    fail "타입이 목록에 없다" "쓸 수 있는 타입: ${COMMIT_TYPES}"
  fi
  if ! printf '%s' "$title" | grep -qE "^(${COMMIT_TYPES})(\([^()[:space:]]+\))?!?: [^[:space:]]"; then
    t="$(printf '%s' "$title" | grep -oE "^(${COMMIT_TYPES})" | head -n 1)"
    fail "타입 뒤 모양이 틀렸다" "예: ${t}: 요약 · ${t}(범위): 요약 · ${t}!: 요약 — 콜론 뒤 공백 하나, 범위 괄호 안에 공백 없이"
  fi
fi

if [ -n "$COMMIT_ISSUE_KEY" ]; then
  # 선언한 키로 시작하는 대괄호만 본다. arr[0] · [WIP] 같은 대괄호는 상관없다.
  k="$COMMIT_ISSUE_KEY"
  wrong="$(printf '%s' "$title" | grep -oiE "\[${k}([^]A-Za-z][^]]*)?(\]|$)" \
           | grep -vE "^\[${k}-[0-9]+\]$" | head -n 1)"
  if [ -n "$wrong" ]; then
    fail "이슈키 모양이 틀렸다: $wrong" "[${k}-번호] 로 적는다. 예: [${k}-12]"
  fi
fi

exit 0
