# backend.hcl 로 복사해 채운다. backend.hcl 은 커밋하지 않는다 (버킷 이름).
#   cp backend.hcl.example backend.hcl
#   terraform init -backend-config=backend.hcl
# 버킷은 infra/README.md 「처음 한 번」에서 한 번 만든다 (버전 관리 · 퍼블릭 차단)

bucket       = "newlearn-tfstate-<만들 때 붙인 접미사>"
key          = "control-plane/terraform.tfstate"
region       = "ap-northeast-2"
profile      = "newlearn-apply"
use_lockfile = true # DynamoDB 없이 S3 에 잠금 파일(.tflock)을 둔다. plan 도 잠금을 잡아서 쓰기 권한이 필요하다
encrypt      = true
