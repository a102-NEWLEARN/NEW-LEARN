# terraform.tfvars 로 복사해 채운다. terraform.tfvars 는 커밋하지 않는다 (관리자 IP · 메일).
#   cp terraform.tfvars.example terraform.tfvars

ssh_public_key     = "<내 SSH 공개키 — ssh-ed25519 로 시작하는 한 줄>"
admin_cidrs        = ["<내 PC 공인 IP>/32"]
worker_cidrs       = [] # Lightsail 을 받으면 그 공인 IP 를 /32 로 넣는다
budget_alert_email = "<예산 알림을 받을 메일>"
# 예산은 variables.tf 의 기본값(승인 금액 92.27 달러, 10/1 부터 누적)을 쓴다
