# NEW:LEARN 로컬 개발 환경변수. 이 파일을 .env 로 복사해 쓴다 (.env 는 커밋하지 않는다).
#   cp .env.example .env
# compose.yaml 이 읽고, IDE 에서 띄운 API · 워커도 같은 파일을 읽는다 (docs/dev-environment.md).
# 줄 끝에 주석을 달거나 값에 따옴표를 쓰지 않는다 — API 는 이 파일을 properties 형식으로 읽어서 그것까지 값이 된다.

# DB (PostgreSQL + pgvector)
# 로컬 컨테이너 전용 값이다. DB 포트는 이 컴퓨터(127.0.0.1)에만 열린다.
# DB 볼륨을 처음 만들 때 한 번 들어간다. 나중에 바꾸면 DB 볼륨을 지우고 다시 띄운다 (docs/dev-environment.md 「자주 막히는 곳」).
POSTGRES_DB=newlearn
POSTGRES_USER=newlearn
POSTGRES_PASSWORD=local

# 내 컴퓨터에 여는 포트. 이미 쓰는 포트가 있으면 바꾼다
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080
AI_PORT=8000
FRONTEND_PORT=5173

# 로그인 세션 · CSRF 번호표 쿠키에 Secure 를 붙일지. 로컬은 http 라 false, 사이트(https)는 true (Jira 62)
SESSION_COOKIE_SECURE=false
# 직원용 문(/internal/v1) 출입증 — 워커 키는 W1, 배치 키는 B2 · B1 만 연다. 비우면 모두 막힌다 (docs/api.md 1절)
# 로컬에서 W1 · B2 · B1 을 불러 볼 때만 채운다 — 두 칸은 서로 다른 긴 글자여야 한다(같으면 API 가 뜨지 않는다). compose 로 띄우면 backend 에도 넘긴다
INTERNAL_WORKER_KEY=
INTERNAL_BATCH_KEY=
# 용어사전(A19)이 부르는 국립국어원 표준국어대사전 Open API 인증 키. 비우면 용어사전이 늘 502 다 (docs/api-screen.md A19)
# 키는 stdict.korean.go.kr 개발 지원(Open API)에서 신청한다. 호스트에서 IDE · ./gradlew bootRun 으로 띄운 backend 만 읽는다 — compose 의 backend 컨테이너에는 아직 넘기지 않는다
STDICT_API_KEY=
# 뉴스 수집 배치가 NewsData 최신 기사를 받을 키. 로컬에서 받기만 돌려 볼 때만 채운다(요청 하나에 크레딧 1 안팎) — compose 는 이 값을 쓰지 않는다
# 돌리는 법 · 사이트의 봉인 Secret 은 infra/server/ingest.md
NEWSDATA_API_KEY=

# LLM (SSAFY GMS)
# mock 은 GMS 를 부르지 않고 모의 응답을 쓴다. gms 는 실제로 불러 토큰 비용이 든다 (SSOT.md 3절 예산)
LLM_MODE=mock
GMS_MODEL=gpt-6-luna
# LLM_MODE=gms 일 때만 채운다. 키는 각자 SSAFY GMS 에서 받는다
# backend 의 용어사전 문맥 뜻(A26)은 LLM_MODE 를 보지 않는다 — 키 · 주소가 있으면 「의미」를 누를 때마다 GMS 를 불러 비용이 든다.
# 로컬에서 부르지 않으려면 비워 둔다(비면 502). 하루 상한은 MEANING_DAILY_LIMIT(기본 3000, 0 이면 끔)
GMS_API_KEY=
GMS_BASE_URL=
# 로컬 compose 의 ai 워커가 mock 응답으로 큐를 읽게 할 때만 true(INTERNAL_WORKER_KEY 도 채운다). 비우면 큐를 읽지 않는다
WORKER_ALLOW_MOCK=
# EMBED 워커(기사 벡터)를 켤 때만 true. mock 이면 모델 없이 가짜 벡터 (Jira S15P31A102-185)
EMBED_WORKER_ENABLED=
